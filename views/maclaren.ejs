<!-- importando o headeder -->
 <%- include('partials/header') %>
<!-- importando  navbar -->
<%- include('partials/navbar') %>

<style>
    th,td,tr{
    padding: 15px;
    }
    #hs{
    margin: auto;
    justify-content: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    }
    .card-header{
        height: 280px;
    }
    
</style>


 <div class="container">
            <div class="card" >
                <div class="card-header bg-warning">
                    <div id="hs">
                        <h1>Cadastrar novo Integrante</h1>
                        <img src="./images/maclaren.png" width="150px" alt="Logo Equipe MacLaren">
                    </div>
                    
                </div>
                <div class="card-body">
                    <form action="/maclaren/cadastrar" method="POST">
                        <label for="nome">Nome da pessoa:</label>
                        <input type="text" id="nome" name="nome" placeholder="Insira o nome da pessoa" class="form-control" required>

                        <label for="funcao">função da pessoa:</label>
                        <input type="text" id="funcao" name="funcao" placeholder="Insira a função da pessoa" class="form-control" required>

                        <label for="idade">idade da pessoa:</label>
                        <input type="text" id="idade" name="idade" placeholder="Insira a idade da pessoa" class="form-control" required>

                        <label for="nacionalidade">Nacionalidade da pessoa:</label>
                        <input type="text" id="nacionalidade" name="nacionalidade" placeholder="Insira a nacionalidade da pessoa" class="form-control" required>
                        <br>
                        <!-- Botão de cadastrar -->
                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
        <br>

 <div class="container">
            <div class="card">
                <div class="card-header bg-warning">
                    <div id="hs">
                        <h1>MacLaren</h1>
                        <img src="./images/maclaren.png" width="150px" alt="Logo Equipe MacLaren">
                    </div>
                    
                </div>
                <div class="card-body me-5">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>Função:</th>
                                <th>Idade:</th>
                                <th>Nacionalidade:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% maclaren.forEach(maclaren=> { %>
                                <tr>
                                    <td><img src="<%= maclaren.img %>" alt="foto de <%= maclaren.img %>" width="150px"></td>
                                    <td>
                                        <%= maclaren.nome %>
                                    </td>
                                    <td>
                                        <%= maclaren.funcao %>
                                    </td>
                                    <td>
                                        <%= maclaren.idade %>
                                    </td>
                                    <td>
                                        <%= maclaren.nacionalidade %>
                                    </td>
                                     <!-- BOTÃO DE EDITAR -->
                                     <td><a class="btn btn-warning" href="/maclaren/editar/<%= maclaren.id %>">Editar</a></td>
                                     <td><a class="btn btn-danger" href="/maclaren/excluir/<%= maclaren.id %>" onclick="return confirm('Deseja mesmo excluir o <%= maclaren.nome %>')">Excluir</a></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

   <!-- importando o footer -->
<%- include ('partials/footer.ejs') %>

