<!-- importando o headeder -->
 <%- include('partials/header') %>
<!-- importando  navbar -->
<%- include('partials/navbar') %>

<style>
    th,td,tr{
    padding: 15px;
    }
    #hs{
        margin: auto;
        justify-content: center;
        align-items: center;
        display: flex;
        flex-direction: column;
    }
    .card-header{
        height: 280px;
    }

</style>

 <div class="container">
            <div class="card">
                <div class="card-header bg-success">
                  
                    <div id="hs">
                        <h1> Mercedes</h1>
                        <img src="./images/mercedes.png" width="150px" alt="Logo Equipe Mercedes">
                    </div>
                    
                </div>
                <div class="card-body me-5">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>Função:</th>
                                <th>Idade:</th>
                                <th>Nacionalidade:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% mercedes.forEach(mercedes=> { %>
                                <tr>
                                    <td><img src="<%= mercedes.img %>" alt="foto de <%= mercedes.img %>" width="150px"></td>
                                    <td>
                                        <%= mercedes.nome %>
                                    </td>
                                    <td>
                                        <%= mercedes.funcao %>
                                    </td>
                                    <td>
                                        <%= mercedes.idade %>
                                    </td>
                                    <td>
                                        <%= mercedes.nacionalidade %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

   <!-- importando o footer -->
<%- include ('partials/footer.ejs') %>

