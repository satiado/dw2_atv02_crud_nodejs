<!-- importano o headeder -->
 <%- include('partials/header') %>
<!-- importando  navbar -->
<%- include('partials/navbar') %>

<style>
    th,td,tr{
    padding: 15px;
    }
        #hs{
        margin: auto;
        justify-content: center;
        align-items: center;
        display: flex;
        flex-direction: column;
    }
    .card-header{
        height: 280px;
    }


    
</style>


 <div class="container">
            <div class="card" >
                <div class="card-header bg-danger">
                    <div id="hs">
                        <h1>Cadastrar novo Integrante</h1>
                         <img src="./images/ferrari.png" width="150px" alt="Logo Equipe Ferrari">
                    </div>
                    
                </div>
                <div class="card-body">
                    <form action="/ferrari/cadastrar" method="POST">
                        <label for="nome">Nome da pessoa:</label>
                        <input type="text" id="nome" name="nome" placeholder="Insira o nome da pessoa" class="form-control" required>

                        <label for="funcao">função da pessoa:</label>
                        <input type="text" id="funcao" name="funcao" placeholder="Insira a função da pessoa" class="form-control" required>

                        <label for="idade">idade da pessoa:</label>
                        <input type="text" id="idade" name="idade" placeholder="Insira a idade da pessoa" class="form-control" required>

                        <label for="nacionalidade">Nacionalidade da pessoa:</label>
                        <input type="text" id="nacionalidade" name="nacionalidade" placeholder="Insira a nacionalidade da pessoa" class="form-control" required>
                        <br>
                        <!-- Botão de cadastrar -->
                        <button type="submit" class="btn btn-success">Cadastrar</button>
                        <!-- Botão de limpar -->
                        <button type="reset" class="btn btn-danger">Limpar</button>
                    </form>
                    <hr>
                </div>
            </div>
        </div>
        <br>

 <div class="container">
            <div class="card">
                <div class="card-header bg-danger">
                    <div id="hs">
                        <h1> Ferrari</h1>
                        <img src="./images/ferrari.png" width="150px" alt="Logo Equipe Ferrari">
                    </div>                
                </div>
                <div class="card-body">
                    <table>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Nome:</th>
                                <th>Função:</th>
                                <th>Idade:</th>
                                <th>naturalidade:</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% ferrari.forEach(ferrari=> { %>
                                <tr>
                                    <td>
                                        <img src="<%= ferrari.img %>" alt="foto de <%= ferrari.img %>" width="150px">
                                    </td>
                                    <td>
                                        <%= ferrari.nome %>
                                    </td>
                                    <td>
                                        <%= ferrari.funcao %>
                                    </td>
                                    <td>
                                        <%= ferrari.idade %>
                                    </td>
                                    <td>
                                        <%= ferrari.nacionalidade %>
                                    </td>
                                     <!-- BOTÃO DE EDITAR -->
                                     <td><a class="btn btn-warning" href="/ferrari/editar/<%= ferrari.id %>">Editar</a></td>
                                     <td><a class="btn btn-danger" href="/ferrari/excluir/<%= ferrari.id %>" onclick="return confirm('Deseja mesmo excluir o <%= ferrari.nome %>')">Excluir</a></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

   <!-- importando o footer -->
<%- include ('partials/footer.ejs') %>