<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h1>Editar Integrante</h1>
            <hr>
        </div>
        <div class="card-body">
            <form action="/ferrari/alterar" method="POST">
                <label for="nome">Nome do Integrante</label>
                <input type="text" name="nome" id="nome" class="form-control" required value="<%= ferrari.nome %>">
                <label for="funcao">Função do Integrante</label>
                <input type="text" name="funcao" id="funcao" class="form-control" required value="<%= ferrari.funcao %>">
                <label for="idade">Idade do Integrante</label>
                <input type="text" name="idade" id="idade" class="form-control" required value="<%= ferrari.idade %>">
                <label for="nacionalidade">Nacionalidade do Integrante</label>
                <input type="text" name="nacionalidade" id="nacionalidade" class="form-control" required value="<%= ferrari.nacionalidade %>">
                <!-- Campo invisível com a id do Integrante -->
                 <input type="hidden" name="id" id="id" value="<%= ferrari.id %>">
                <br>
                <button type="submit" class="btn btn-warning" onclick="return confirm('Deseja mesmo alterar o integrante <%= ferrari.nome %>')">Alterar</button>
                <a href="/ferrari">
                    <button type="button" class="btn btn-danger">Cancelar</button>
                </a>
                
            </form>
        </div>
    </div>
</div>

<%- include ('partials/footer.ejs') %>